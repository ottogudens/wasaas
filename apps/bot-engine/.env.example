# ============================================================
# apps/bot-engine/.env.example
# Copia este archivo como .env en desarrollo local.
# En Railway, configura cada variable en: Settings → Variables
# ============================================================

# ───────────────────────────────────────────────────────────
# OBLIGATORIAS — El bot-engine NO arranca sin estas variables.
# ───────────────────────────────────────────────────────────

# API key compartida con la API NestJS para comunicación interna.
# Debe ser idéntica a la configurada en apps/api/.env
# Genera con: openssl rand -hex 24
# IMPORTANTE: Rota esta key si alguna vez estuvo hardcodeada en el historial de git.
INTERNAL_API_KEY=REEMPLAZA_CON_KEY_SEGURA_MINIMO_16_CHARS

# URL base de la API NestJS (sin slash final).
# En Railway usa la URL pública del servicio api.
API_URL=https://wasaas-production.up.railway.app

# ───────────────────────────────────────────────────────────
# OPCIONALES — Tienen valores por defecto en el código
# ───────────────────────────────────────────────────────────

# Puerto del servidor HTTP (Railway lo inyecta automáticamente).
PORT=3005

# Directorio donde se almacenan las sesiones de WhatsApp.
# Debe ser un volumen persistente en Railway.
SESSIONS_DIR=./sessions

# ───────────────────────────────────────────────────────────
# META (solo si usas Meta Cloud API en lugar de Baileys)
# ───────────────────────────────────────────────────────────
# META_JWT_TOKEN=
# META_NUMBER_ID=
# META_VERIFY_TOKEN=
