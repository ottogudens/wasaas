// Prisma Schema para SaaS Multi-tenant de Agentes IA de WhatsApp
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum PlanType {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
  CORTESIA
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
  TRIAL_EXPIRED
}

enum BotStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  ERROR
}

enum SenderType {
  USER
  BOT
  AGENT
}

model Organization {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  isActive          Boolean        @default(true)
  mpAccessToken     String?        @db.Text // Credencial MercadoPago para cobros directos de la organización
  mpPublicKey       String?
  mpWebhookSecret   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  bots              BotInstance[]
  subscriptions     Subscription[]
  documents         KnowledgeDocument[]
  semanticCaches    SemanticMemoryCache[]
  invoices          Invoice[]
  featureFlags      OrganizationFeatureFlag[]
}

model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String?
  role           Role         @default(ADMIN)
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  price        Float
  maxBots      Int      @default(1)
  maxDocs      Int      @default(50)
  features     String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Float
  description    String?
  status         String       @default("PAID") // "PAID" | "PENDING" | "OVERDUE"
  pdfUrl         String?
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               PlanType           @default(STARTER)
  customPlanName     String?
  status             SubscriptionStatus @default(PENDING)
  mpPreapprovalId    String?            @unique // ID de Suscripción en MercadoPago
  mpPayerId          String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model BotInstance {
  id              String        @id @default(uuid())
  tenantId        String        @unique // Identificador único de instancia para BuilderBot Manager
  name            String
  phoneNumber     String?
  provider        String        @default("baileys") // "baileys" | "meta"
  metaJwtToken    String?       @db.Text
  metaNumberId    String?
  metaVerifyToken String?
  status          BotStatus     @default(DISCONNECTED)
  qrCode          String?       @db.Text
  pairingCode     String?
  systemPrompt    String?       @db.Text
  aiModel         String        @default("gpt-4o-mini")
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Conversation {
  id            String       @id @default(uuid())
  botId         String
  bot           BotInstance  @relation(fields: [botId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName  String?
  isHumanMode   Boolean      @default(false) // Handoff a humano
  messages      Message[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([botId, customerPhone])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         SenderType
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

model KnowledgeDocument {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String?
  sourceType     String                 @default("TEXT") // "TEXT" | "FILE" | "URL"
  sourceUrl      String?
  lastSyncedAt   DateTime?
  chunks         DocumentVectorChunk[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model DocumentVectorChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String            @db.Text
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime          @default(now())

  @@index([documentId])
}

model SemanticMemoryCache {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queryText      String       @db.Text
  queryEmbedding Unsupported("vector(1536)")?
  replyText      String       @db.Text
  hitCount       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  percentage  Int      @default(0) // Rollout 0-100%
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizationFeatureFlag {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureName    String
  isEnabled      Boolean      
  createdAt      DateTime     @default(now())

  @@unique([organizationId, featureName])
}
