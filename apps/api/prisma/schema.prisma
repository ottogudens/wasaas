// Prisma Schema para SaaS Multi-tenant de Agentes IA de WhatsApp
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  ADMIN
  MEMBER
}

enum PlanType {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
}

enum BotStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  ERROR
}

enum SenderType {
  USER
  BOT
  AGENT
}

model Organization {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  bots              BotInstance[]
  subscriptions     Subscription[]
  documents         KnowledgeDocument[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String?
  role           Role         @default(ADMIN)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               PlanType           @default(STARTER)
  status             SubscriptionStatus @default(PENDING)
  mpPreapprovalId    String?            @unique // ID de Suscripción en MercadoPago
  mpPayerId          String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model BotInstance {
  id             String        @id @default(uuid())
  tenantId       String        @unique // Identificador único de instancia para BuilderBot Manager
  name           String
  phoneNumber    String?
  status         BotStatus     @default(DISCONNECTED)
  qrCode         String?       @db.Text
  systemPrompt   String?       @db.Text
  aiModel        String        @default("gpt-4o-mini")
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Conversation {
  id            String       @id @default(uuid())
  botId         String
  bot           BotInstance  @relation(fields: [botId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName  String?
  isHumanMode   Boolean      @default(false) // Handoff a humano
  messages      Message[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([botId, customerPhone])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         SenderType
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

model KnowledgeDocument {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String?
  chunks         DocumentVectorChunk[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model DocumentVectorChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String            @db.Text
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime          @default(now())

  @@index([documentId])
}
