# ============================================================
# apps/api/.env.example
# Copia este archivo como .env en desarrollo local.
# En Railway, configura cada variable en: Settings → Variables
# ============================================================

# ───────────────────────────────────────────────────────────
# OBLIGATORIAS — La app NO arranca sin estas variables.
# ───────────────────────────────────────────────────────────

# Secreto para firmar JWT. Mínimo 32 caracteres aleatorios.
# Genera uno seguro con: openssl rand -hex 32
JWT_SECRET=REEMPLAZA_CON_32_CARACTERES_ALEATORIOS_MINIMO

# API key compartida entre api y bot-engine para comunicación interna.
# Mínimo 16 caracteres. Genera con: openssl rand -hex 24
# IMPORTANTE: Rota esta key si alguna vez estuvo hardcodeada en el historial de git.
INTERNAL_API_KEY=REEMPLAZA_CON_KEY_SEGURA_MINIMO_16_CHARS

# Conexión a Postgres con pgvector (Railway la inyecta automáticamente).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# API key de OpenAI para GPT y Whisper. Comienza con "sk-".
OPENAI_API_KEY=sk-REEMPLAZA_CON_TU_KEY_DE_OPENAI

# ───────────────────────────────────────────────────────────
# OPCIONALES — Tienen valores por defecto en el código
# ───────────────────────────────────────────────────────────

# Puerto del servidor HTTP (Railway lo inyecta automáticamente).
PORT=3001

# Credenciales del Super Admin (seed/sincronización automática al arrancar).
# OBLIGATORIAS — check-env.ts detiene el arranque si faltan. No existe valor
# por defecto: define un email real y una contraseña fuerte y única por entorno
# (ej. `openssl rand -base64 18`). Nunca reutilices un valor de esta guía.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# URL del frontend (para logs y CORS — actualmente abierto).
FRONTEND_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────
# META (solo si usas Meta Cloud API en lugar de Baileys)
# ───────────────────────────────────────────────────────────
# META_JWT_TOKEN=
# META_NUMBER_ID=
# META_VERIFY_TOKEN=

# ───────────────────────────────────────────────────────────
# MERCADO PAGO (opcional si usas pagos)
# ───────────────────────────────────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=
